[Unit]
Description=Scout idea run (costs fuel - once a day)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/ecosystem/agents/scout
# Scout writes ONE line to state/last-run.txt; this appends it to MEMORY.md.
#
# Scout was asked twice, in two wordings, at the top of its instructions, to
# append to MEMORY.md rather than replace it. It replaced it both times and
# destroyed the log. Appending a line is deterministic work, so it belongs in
# code - the same reason the fetchers compute the indicators instead of the
# agent. Scout now owns a scratch file it is free to overwrite, and plain code
# does the append it kept getting wrong.
#
# "Wrote no ideas" and "did nothing" stay different things: Scout is told to
# propose nothing when ideas are already piling up, and those runs pass.
ExecStart=/bin/bash -lc 'D=/root/ecosystem/agents/scout; L=$D/state/last-run.txt; M=$D/MEMORY.md; F=$D/state/ideas.json; \
T=$(stat -c %%Y "$L" 2>/dev/null || echo 0); I=$(stat -c %%Y "$F" 2>/dev/null || echo 0); \
/usr/bin/openclaw agent --agent scout --message "scheduled idea run" --session-id "wake-scout-$(date +%%s)" --timeout 600 --json; \
U=$(stat -c %%Y "$L" 2>/dev/null || echo 0); J=$(stat -c %%Y "$F" 2>/dev/null || echo 0); \
if [ "$U" -le "$T" ]; then echo "SCOUT RECORDED NOTHING: state/last-run.txt not written. Every run writes one line there, including a run that deliberately proposes no ideas."; exit 1; fi; \
LINE=$(head -c 400 "$L" | tr -d "\\n" | sed "s/[[:space:]]\\+/ /g"); \
if [ -z "$LINE" ]; then echo "SCOUT RECORDED NOTHING: state/last-run.txt is empty."; exit 1; fi; \
printf "%%s\\n" "$LINE" >> "$M"; \
if [ "$J" -gt "$I" ]; then echo "scout wrote ideas.json; logged to MEMORY.md: $LINE"; \
else echo "scout proposed no new ideas - a pass; logged to MEMORY.md: $LINE"; fi'
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
