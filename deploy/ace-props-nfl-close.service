[Unit]
Description=Ace Props NFL: settle finished bets and take each bet's closing price once, just before kick-off (no AI)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
WorkingDirectory=/root/ecosystem
ExecStart=/usr/bin/flock /run/ace-props-nfl.lock /usr/bin/python3 /root/ecosystem/scripts/ace-props-nfl.py close
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
