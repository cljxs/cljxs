[Unit]
Description=Ace agent cycle (THIS one costs fuel - 3x per day)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/ecosystem
# Fresh session id per wake; reused sessions cause runaway loops.
# A cycle that never updates state is a failed cycle, not a successful
# one. systemd only knows the process exited 0. Both agents have already
# shipped a run that skipped its state write and was logged as a success.
ExecStart=/bin/bash -lc 'F=/root/ecosystem/agents/ace/state/bankroll.json; \
B=$(stat -c %%Y "$F" 2>/dev/null || echo 0); \
/usr/bin/openclaw agent --agent ace --message "scheduled cycle" --session-id "wake-ace-$(date +%%s)" --timeout 600 --json; \
A=$(stat -c %%Y "$F" 2>/dev/null || echo 0); \
if [ "$A" -le "$B" ]; then echo "ACE WROTE NOTHING: $F unchanged - the cycle did not update state"; exit 1; fi; \
echo "ace updated state ok"'
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
