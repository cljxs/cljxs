[Unit]
Description=Ace agent cycle (THIS one costs fuel - 3x per day)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/ecosystem
# Fresh session id per wake; reused sessions cause runaway loops.
ExecStart=/bin/bash -lc '/usr/bin/openclaw agent --agent ace --message "scheduled cycle" --session-id "wake-ace-$(date +%%s)" --timeout 600 --json'
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
