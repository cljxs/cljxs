[Unit]
Description=Ace agent cycle (THIS one costs fuel - 2x per day)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ECOSYSTEM_ROOT=/root/ecosystem
WorkingDirectory=/root/ecosystem
# The work is in scripts/ace-cycle.sh: seed the bankroll if it is missing,
# snapshot MEMORY.md and cycle_count, wake the agent with a fresh session id
# (a reused one causes runaway loops), then run the verifier.
#
# The old guard here only checked that bankroll.json's mtime moved. That is
# not enough. Ace ran a cycle in 23 seconds, reported no error, and wrote
# nothing at all - and "wrote nothing" is indistinguishable from "correctly
# passed on every game", which is what Ace is supposed to do most days.
# The verifier names the missing deliverable instead.
ExecStart=/root/ecosystem/scripts/ace-cycle.sh
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
