[Unit]
Description=Belfort agent cycle (THIS one costs fuel - runs twice per trading day)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/ecosystem
# A fresh session id per wake is required; reused sessions cause runaway loops.
ExecStart=/bin/bash -lc '/usr/bin/openclaw agent --agent belfort --message "scheduled cycle" --session-id "wake-belfort-$(date +%%s)" --timeout 600 --json'
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
