[Unit]
Description=Fury daily briefing (costs fuel - once a day)
Documentation=https://github.com/cljxs/cljxs

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/ecosystem/agents/fury
# Refresh the system snapshot immediately before waking Fury, so the briefing
# describes the ecosystem as it is now rather than as it was this morning.
ExecStartPre=/usr/bin/python3 /root/ecosystem/scripts/fury-collect.py
# The briefing is the deliverable and it is a FILE. Fury made a single tool
# call, read the system state, wrote the briefing into its reply and saved
# nothing - three times, through three rewordings of "write the file".
#
# So fury-collect.py now leaves today's briefing on disk with the headings
# already in it, and Fury only has to fill it in. Creating a file from nothing
# was the step it kept skipping; editing an existing one is a different task.
# The check is whether the placeholder marker is gone.
#
# Fury writes one line to state/last-run.txt; this appends it to MEMORY.md.
# Scout was asked twice to append to its own log and destroyed it twice, so
# that job now lives in code for both of them.
ExecStart=/bin/bash -lc 'D=/root/ecosystem/agents/fury; R=$D/reports; L=$D/state/last-run.txt; M=$D/MEMORY.md; \
T=$(stat -c %%Y "$L" 2>/dev/null || echo 0); \
/usr/bin/openclaw agent --agent fury --message "scheduled briefing" --session-id "wake-fury-$(date +%%s)" --timeout 600 --json; \
TODAY=$(date -u +%%F); BRIEF=$R/$TODAY.md; \
if [ ! -f "$BRIEF" ]; then echo "FURY: $BRIEF is missing - fury-collect.py should have created it. The collector failed, not the agent."; exit 1; fi; \
if grep -q "FURY-HAS-NOT-WRITTEN-THIS-YET" "$BRIEF"; then echo "FURY WROTE NOTHING: $BRIEF still carries the placeholder marker. The briefing is a file to fill in, not a reply."; exit 1; fi; \
U=$(stat -c %%Y "$L" 2>/dev/null || echo 0); \
if [ "$U" -le "$T" ]; then echo "FURY WROTE THE BRIEFING BUT LOGGED NOTHING: state/last-run.txt not written."; exit 1; fi; \
LINE=$(head -c 400 "$L" | tr -d "\\n" | sed "s/[[:space:]]\\+/ /g"); \
if [ -z "$LINE" ]; then echo "FURY RECORDED NOTHING: state/last-run.txt is empty."; exit 1; fi; \
printf "%%s\\n" "$LINE" >> "$M"; \
echo "fury wrote the briefing; logged to MEMORY.md: $LINE"'
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
