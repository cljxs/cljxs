[Unit]
Description=Belfort's sell-rule check, every 10 minutes 09:45-15:55 Eastern on weekdays

[Timer]
# Every 10 minutes since 2026-10-22 (owner). Hourly, a stop crossed at 10:40
# waited until 11:35, and `belfort-learn.py replay` put the cost of that at
# $38 on his trades and $125 on the no-AI book's. The fetcher writes prices
# at :00, :10 ...; this runs five minutes after each, from 09:45 (the 09:35
# wake checks the open itself). No AI and no buys - code only, free.
OnCalendar=Mon..Fri 09:45/10 America/New_York
OnCalendar=Mon..Fri 10..15:05/10 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
