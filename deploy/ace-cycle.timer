[Unit]
Description=Wake Ace twice a day

[Timer]
# Times are US/Eastern because they track US sports schedules, not the user's
# clock. In US/Central these fire at 10:30 and 22:30.
#
# 11:30 is the betting wake. It was 15:00 until 2026-10-03, when the owner
# moved it: college football's noon ET (11:00 Central) kickoffs had already
# started by 15:00, and NFL Sunday's 13:00 ET games were 13.5 hours past the
# 23:30 wake - outside BET_WINDOW_HOURS (12) - so no wake could ever bet them.
# At 11:30 everything to 23:30 ET is inside the window. 23:30 is the grading
# wake: the day's games are final.
#
# There used to be a 09:00 wake as well. It was dropped because nothing it
# could see was actionable - the earliest first pitch is around 13:00 ET and
# most of the slate is evening, so at 09:00 no lineup is posted and no scratch
# is known. Ace's own bar requires "real information the market has not priced
# yet", and at 09:00 there is none. It is a third of the fuel for the wake
# least able to clear the bar.
OnCalendar=*-*-* 11:30 America/New_York
OnCalendar=*-*-* 23:30 America/New_York
Persistent=false
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
