[Unit]
Description=Wake Belfort at US market open, midday and close

[Timer]
# Times are US/Eastern because they track the MARKET, not the user's clock.
# 09:35 ET is five minutes after the opening bell; moving this to Central
# would put it 35 minutes after the open. In US/Central these fire at
# 08:35, 11:00 and 14:55.
# 09:35 lets the opening auction settle; 15:55 runs just before the close.
# 12:00 since 2026-10-22 (owner): between them a buy waited six hours. Each
# wake is a plan wake (et_time.BELFORT names it "midday") - keep it at three.
OnCalendar=Mon..Fri 09:35 America/New_York
OnCalendar=Mon..Fri 12:00 America/New_York
OnCalendar=Mon..Fri 15:55 America/New_York
Persistent=false
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
