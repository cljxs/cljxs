[Unit]
Description=Wake Belfort at US market open and close

[Timer]
# Times are US/Eastern because they track the MARKET, not the user's clock.
# 09:35 ET is five minutes after the opening bell; moving this to Central
# would put it 35 minutes after the open. In US/Central these fire at
# 08:35 and 14:55.
# Twice per trading day. 09:35 lets the opening auction settle; 15:55 runs
# just before the close. Each wake costs money - keep it at two.
OnCalendar=Mon..Fri 09:35 America/New_York
OnCalendar=Mon..Fri 15:55 America/New_York
Persistent=false
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
