# Copy to credentials.env in this folder and fill in.
#   cp credentials.env.example credentials.env && chmod 600 credentials.env
#
# credentials.env is gitignored. NEVER commit it - this repo is public.
# Emily builds locally without these; she just cannot create the drafts.

# Your EXISTING OpenRouter key - the same one the other agents use.
# This is not a new provider; OpenRouter serves image models on the same key.
OPENROUTER_API_KEY=

# Etsy API v3 - https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# Printify - https://printify.com/app/account/api
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
