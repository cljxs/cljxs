# Paul's credentials. credentials.env is gitignored - NEVER commit it, this
# repo is public. Set values without an editor:
#   python3 scripts/set-credential.py paul VERCEL_TOKEN
#
# Paul's model uses the SAME OpenRouter key as every other agent, set through
# openclaw - nothing for it goes here.

# Vercel - https://vercel.com/account/tokens. Deploys and removes previews.
VERCEL_TOKEN=

# Only if the previews should go to a team other than your default scope.
#VERCEL_TEAM_ID=
